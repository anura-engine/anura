{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "Visual Studio",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/visual-studio",
      "cacheVariables": {
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/conan-provider.cmake",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "FETCHCONTENT_QUIET": "FALSE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Visual Studio",
      "configuration": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Visual Studio",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "Debug",
      "configurePreset": "Visual Studio",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Release",
      "configurePreset": "Visual Studio",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
